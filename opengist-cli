import argparse
import os
import ssl
import sys
from pathlib import Path

import httpx
from wcwidth import wcswidth


def _width(s: str) -> int:
    w = wcswidth(s)
    return w if w >= 0 else len(s)


def _pad(s: str, w: int) -> str:
    return s + " " * (w - _width(s))


class ConfigError(Exception):
    pass


def get_token() -> str:
    token = os.environ.get("OPENGIST_CLI_TOKEN")
    if not token:
        raise ConfigError("OPENGIST_CLI_TOKEN is not set")
    return token


def get_opengist_url() -> str:
    url = os.environ.get("OPENGIST_CLI_URL")
    if not url:
        raise ConfigError("OPENGIST_CLI_URL is not set")
    return url


def get_gists_url() -> str:
    return f"{get_opengist_url()}/api/gists"


def gist_url(gist: str) -> str:
    return f"{get_gists_url()}/{gist}"


def get_users_url(username: str) -> str:
    return f"{get_opengist_url()}/api/users/{username}"



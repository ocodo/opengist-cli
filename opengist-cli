class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.exit(2, f"opengist-cli: {message}\n")


def ca_bundle() -> str | bool:
    paths = ssl.get_default_verify_paths()

    if paths.cafile:
        return paths.cafile

    return True


def request(
    method: str,
    url: str,
    *,
    json: dict | None = None,
    params: dict | None = None,
) -> httpx.Response:
    token = get_token()

    return httpx.request(
        method,
        url,
        json=json,
        params=params,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
        },
        verify=ca_bundle(),
        timeout=30,
    )


def show_response(response: httpx.Response) -> None:
    if response.is_success:
        if not response.content:
            return

        try:
            data = response.json()
        except ValueError:
            print(response.text)
            return

        if isinstance(data, dict):
            url = data.get("html_url") or data.get("url")
            if url:
                print(url)
                return

        print(response.text)
        return

    print(
        f"opengist-cli: OpenGist returned HTTP {response.status_code}",
        file=sys.stderr,
    )

    if response.text:
        print(response.text, file=sys.stderr)


def parser_for(command: str) -> Parser:
    parser = Parser(add_help=False)

    if command == "add":
        parser.add_argument("-t", "--title")
        parser.add_argument("-d", "--description")
        parser.add_argument("--private", action="store_true")
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("files", nargs="+")
    elif command == "edit":
        parser.add_argument("-t", "--title")
        parser.add_argument("-d", "--description")
        parser.add_argument("--private", action="store_true")
        parser.add_argument("--public", action="store_true")
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("gist")
    elif command == "delete":
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("gist")
    elif command == "list":
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("--markdown", action="store_true")
        parser.add_argument("--page", type=int, default=1)
        parser.add_argument("--per-page", type=int, default=30)
        parser.add_argument("username", nargs="?")
    else:
        raise ValueError(command)

    return parser


def add(args: argparse.Namespace) -> int:
    files: dict[str, dict[str, str]] = {}

    for filename in args.files:
        path = Path(filename)

        if not path.is_file():
            print(
                f"opengist-cli: file not found: {filename}",
                file=sys.stderr,
            )
            return 1

        files[path.name] = {
            "content": path.read_text(),
        }

    payload: dict = {
        "files": files,
    }

    if args.title is not None:
        payload["title"] = args.title

    if args.description is not None:
        payload["description"] = args.description

    if args.private:
        payload["visibility"] = "private"

    try:
        response = request("POST", get_gists_url(), json=payload)
    except httpx.HTTPError as exc:
        print(f"opengist-cli: request failed: {exc}", file=sys.stderr)
        return 1

    show_response(response)
    return 0 if response.is_success else 1


def edit(args: argparse.Namespace) -> int:
    if args.private and args.public:
        print(
            "opengist-cli: --private and --public are mutually exclusive",
            file=sys.stderr,
        )
        return 2

    payload: dict = {}

    if args.title is not None:
        payload["title"] = args.title

    if args.description is not None:
        payload["description"] = args.description

    if args.private:
        payload["visibility"] = "private"
    elif args.public:
        payload["visibility"] = "public"

    if not payload:
        print("opengist-cli: nothing to edit", file=sys.stderr)
        return 2

    try:
        response = request(
            "PATCH",
            gist_url(args.gist),
            json=payload,
        )
    except httpx.HTTPError as exc:
        print(f"opengist-cli: request failed: {exc}", file=sys.stderr)
        return 1

    show_response(response)
    return 0 if response.is_success else 1


def delete(args: argparse.Namespace) -> int:
    try:
        response = request(
            "DELETE",
            gist_url(args.gist),
        )
    except httpx.HTTPError as exc:
        print(f"opengist-cli: request failed: {exc}", file=sys.stderr)
        return 1

    if response.is_success:
        print(f"Deleted {args.gist}")
        return 0

    show_response(response)
    return 1


def list_gists(args: argparse.Namespace) -> int:
    if args.page < 1:
        print("opengist-cli: --page must be at least 1", file=sys.stderr)
        return 2

    if args.per_page < 1:
        print("opengist-cli: --per-page must be at least 1", file=sys.stderr)
        return 2

    params = {
        "page": args.page,
        "per_page": args.per_page,
    }

    gists_url = get_gists_url()

    if args.username:
        gists_url = f"{get_users_url(args.username)}/gists"

    try:
        response = request(
            "GET",
            gists_url,
            params=params,
        )
    except httpx.HTTPError as exc:
        print(f"opengist-cli: request failed: {exc}", file=sys.stderr)
        return 1

    if not response.is_success:
        show_response(response)
        return 1

    try:
        gists = response.json()
    except ValueError:
        print(
            "opengist-cli: invalid response from OpenGist",
            file=sys.stderr,
        )
        return 1

    if not isinstance(gists, list):
        print(
            "opengist-cli: unexpected response from OpenGist",
            file=sys.stderr,
        )
        return 1

    if not gists:
        print("No gists found.")
        return 0

    if args.markdown:
        markdown_table(gists)
    else:
        text_list(gists)


def text_list(gists):
    rows = [(g.get("title") or "", g.get("html_url") or "") for g in gists]

    title_w = max(_width("title"), max(_width(t) for t, _ in rows))
    url_w = max(_width("url"), max(_width(u) for _, u in rows))

    print(f"{'title':<{title_w}} {'url':<{url_w}}\n")

    for title, url in rows:
        print(f"{title:<{title_w}} {url:<{url_w}}")


def markdown_table(gists):
    rows = [(g.get("title") or "", g.get("html_url") or "") for g in gists]

    title_w = max(_width("title"), max(_width(t) for t, _ in rows))
    url_w = max(_width("url"), max(_width(u) for _, u in rows))

    print(f"| {'title':<{title_w}} | {'url':<{url_w}} |")
    print("|-|-|")

    for title, url in rows:
        print(f"| {title:<{title_w}} | {url:<{url_w}} |")


COMMAND_HELP = {
    "add": ADD_HELP,
    "edit": EDIT_HELP,
    "delete": DELETE_HELP,
    "list": LIST_HELP,
}

COMMANDS = {
    "add": add,
    "edit": edit,
    "delete": delete,
    "list": list_gists,
}


def _main() -> int:
    if len(sys.argv) == 1 or sys.argv[1] in ("-h", "--help"):
        print(HELP)
        return 0

    command = sys.argv[1]

    if command not in COMMANDS:
        print(
            f"opengist-cli: unknown command: {command}\n",
            file=sys.stderr,
        )
        print(HELP, file=sys.stderr)
        return 2

    if len(sys.argv) == 2 and command != "list":
        print(COMMAND_HELP[command])
        return 0

    parser = parser_for(command)
    args = parser.parse_args(sys.argv[2:])

    if getattr(args, "help", False):
        print(COMMAND_HELP[command])
        return 0

    return COMMANDS[command](args)


def main() -> int:
    try:
        return _main()
    except ConfigError as e:
        print(f"opengist-cli: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
